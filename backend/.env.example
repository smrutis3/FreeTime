# Claude (building account). Keep the demo account's key out of git.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# k-ID server key from portal.k-id.com -> your product -> Developer Settings (test key).
# Leave empty to run the local mock gate (same tiers, no network).
KID_API_KEY=
KID_API_BASE_URL=https://game-api.test.k-id.com/api/v1
# Set to 1 to force the mock gate even when a key is present.
KID_MOCK=

# Voice (optional, 15:00 slot)
MODULATE_KEY=
INWORLD_KEY=
